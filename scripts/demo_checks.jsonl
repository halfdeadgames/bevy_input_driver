// Self-checking test for examples/driver_demo.rs. Run from the crate folder:
//   cargo run --example driver_demo -- --input-script scripts/demo_checks.jsonl --seed 42
// Expected: every check passes and the process exits with code 0. The button starts not green,
// the click turns it green, and the drag moves the square from left 400, top 250 by (200, 80).
{"cmd":"wait_until_drawn"}
{"cmd":"expect","check":"button_is_green","equals":false}
{"cmd":"click","x":140,"y":80}
{"cmd":"expect","check":"button_is_green","equals":true}
{"cmd":"drag","from":[450,300],"to":[650,380],"frames":12}
{"cmd":"expect","check":"square_top_left","equals":[600,330]}
{"cmd":"quit"}
